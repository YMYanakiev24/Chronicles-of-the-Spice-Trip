    color: '#76e06b'
    glow: '#d6ffc8'
    desc: Koravel's green mercy, knitting flesh and steadying the heart.
    upgrade: "Greater Bloom \u2014 also grants a lingering renewal."
    manaCost: 28
    cooldown: 6
    damage: 0
    speed: 0
    radius: 0
    splash: 0
