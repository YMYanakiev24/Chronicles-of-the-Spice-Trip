    god: hyperaxis
    kind: aoe
    color: '#ffe08a'
    glow: '#ffffff'
    desc: Call down the judgement of the Stormcrown. The sky itself answers.
    upgrade: "Reckoning \u2014 the storm lingers and strikes a second time."
    manaCost: 60
    cooldown: 18
    damage: 120
    speed: 0
    radius: 90
    splash: 0
