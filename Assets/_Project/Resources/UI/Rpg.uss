/* ===========================================================================
   Chronicle (RPG) UI — HUD, book panels, dialogue, death screen, title card.
   Port of the HUD / Book / Dialogue sections of the web game's style.css.
   =========================================================================== */

.rpg-root, .hud, .intro, .dmg-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ---- HUD — vitals ---------------------------------------------------------- */
.crosshair {
    position: absolute;
    left: 50%; top: 50%;
    width: 7px; height: 7px;
    margin-left: -3px; margin-top: -3px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.6);
}
.vitals {
    position: absolute;
    left: 22px; bottom: 22px;
    flex-direction: row;
    align-items: center;
}
.portrait {
    width: 64px; height: 64px;
    border-radius: 32px;
    background-color: #1a3a58;
    border-width: 3px; border-color: var(--gold);
    align-items: center; justify-content: center;
    margin-right: 12px;
}
.level-badge { font-size: 25px; -unity-font-style: bold; color: var(--gold-bright); text-shadow: 0 2px 2px #000000; }
.bars { flex-direction: column; }
.bar-row { margin-bottom: 6px; }
.bar {
    width: 240px; height: 18px;
    background-color: #070f0d;
    border-width: 2px; border-color: rgba(202, 168, 77, 0.7);
    border-radius: 4px;
    overflow: hidden;
}
.bar.xp { height: 9px; }
.bar-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; transition-property: width; transition-duration: 0.18s; }
.health-fill { background-color: #d23a30; }
.mana-fill { background-color: #3a78d8; }
.xp-fill { background-color: #d8a838; }
.bar-label {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-text-align: middle-center;
    font-size: 11px; -unity-font-style: bold;
    color: #ffffff;
    text-shadow: 0 1px 2px #000000;
    padding: 0; margin: 0;
}
.shield-pip { flex-direction: row; align-items: center; }
.shield-val { font-size: 13px; color: #7fc8ff; text-shadow: 0 0 6px #7fc8ff; }

/* ---- HUD — hotbar ------------------------------------------------------------ */
.hotbar {
    position: absolute;
    left: 0; right: 0; bottom: 18px;
    flex-direction: row;
    justify-content: center;
}
.spell-slot {
    width: 54px; height: 54px;
    margin: 0 4px;
    background-color: rgba(26, 20, 37, 0.95);
    border-width: 2px; border-color: var(--gold);
    border-radius: 8px;
    align-items: center; justify-content: center;
    overflow: hidden;
    transition-property: translate;
    transition-duration: 0.1s;
}
.spell-slot:hover { translate: 0 -3px; border-color: var(--purple-bright); }
.spell-slot.empty { border-color: rgba(202, 168, 77, 0.3); opacity: 0.5; }
.spell-slot.empty:hover { translate: 0 0; border-color: rgba(202, 168, 77, 0.3); }
.slot-icon { align-items: center; justify-content: center; }
.slot-cooldown { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background-color: rgba(10, 10, 30, 0.72); }
.slot-key { position: absolute; top: 1px; left: 5px; font-size: 11px; color: var(--gold-bright); -unity-font-style: bold; text-shadow: 0 1px 2px #000000; padding: 0; margin: 0; }

/* ---- HUD — top-left pills -------------------------------------------------------- */
.topleft { position: absolute; left: 22px; top: 18px; flex-direction: column; align-items: flex-start; }
.gold-pill, .region-pill {
    flex-direction: row; align-items: center;
    background-color: #1b130b;
    border-width: 2px; border-color: var(--gold);
    border-radius: 20px;
    padding: 5px 14px;
    margin-bottom: 8px;
}
.gold-val { color: var(--gold-bright); -unity-font-style: bold; }
.region-text { color: var(--green-bright); letter-spacing: 1px; font-size: 14px; -unity-font-style: bold; }

/* ---- HUD — quest tracker ------------------------------------------------------------ */
.quest-tracker {
    position: absolute;
    right: 22px; top: 210px; width: 260px;
    background-color: rgba(14, 10, 22, 0.82);
    border-width: 2px; border-left-width: 4px;
    border-color: rgba(202, 168, 77, 0.7); border-left-color: var(--gold);
    border-radius: 6px;
    padding: 10px 14px;
}
.qt-title-row { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 6px; }
.qt-title { color: var(--gold-bright); font-size: 15px; white-space: normal; }
.ready-tag { font-size: 10px; background-color: var(--green-bright); color: #04140c; padding: 1px 6px; border-radius: 8px; -unity-font-style: bold; margin-left: 6px; }
.qt-item { flex-direction: row; align-items: center; margin: 3px 0; }
.qt-text { font-size: 13px; color: var(--parchment); white-space: normal; flex-shrink: 1; }
.qt-item.done .qt-text { color: var(--green-bright); opacity: 0.7; }

/* ---- HUD — minimap ---------------------------------------------------------------- */
.minimap-frame { position: absolute; right: 22px; top: 18px; width: 170px; height: 170px; }
.minimap { width: 170px; height: 170px; }
.minimap-compass { position: absolute; top: -6px; left: 0; right: 0; -unity-text-align: upper-center; color: var(--gold-bright); font-size: 13px; text-shadow: 0 0 6px #000000; }

/* ---- HUD — prompts, hints, toasts, banner ------------------------------------------- */
.interact-row { position: absolute; left: 0; right: 0; bottom: 96px; align-items: center; }
.interact-prompt {
    background-color: rgba(8, 6, 14, 0.8);
    border-width: 1px; border-color: var(--gold);
    padding: 8px 18px;
    border-radius: 20px;
}
.interact-text { font-size: 15px; color: var(--parchment); }
.hint-row-top { position: absolute; left: 0; right: 0; top: 84px; align-items: center; }
.hint-bar {
    flex-direction: row; align-items: center;
    width: 640px; max-width: 90%;
    background-color: rgba(15, 11, 30, 0.88);
    border-width: 1px; border-color: var(--purple-bright);
    border-radius: 10px;
    padding: 10px 22px;
}
.hint-text { font-size: 15px; color: var(--parchment); white-space: normal; -unity-text-align: middle-center; }

/* Wrapping labels that share a row with an icon: give them a definite width
   (flex-basis 0) so their height is measured at the width they end up with. */
.hint-text, .qt-text, .obj-text, .relic-text, .control-val { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.reminder-row { position: absolute; left: 0; right: 0; bottom: 80px; align-items: center; }
.controls-reminder { font-size: 12px; color: rgba(233, 220, 191, 0.5); white-space: nowrap; }
.toast-stack { position: absolute; left: 0; right: 0; top: 130px; align-items: center; }
.toast {
    background-color: rgba(8, 6, 14, 0.85);
    border-width: 1px; border-color: var(--gold);
    border-radius: 16px;
    padding: 6px 18px;
    margin-bottom: 6px;
    font-size: 14px;
    color: var(--parchment);
}
.toast.gold { color: var(--gold-bright); border-color: var(--gold-bright); }
.toast.warn { color: #ff8a6a; border-color: #ff8a6a; }
.toast.pickup { color: var(--green-bright); border-color: var(--green-bright); }
.toast.xp { color: #7fc8ff; border-color: #7fc8ff; }
.banner-row { position: absolute; left: 0; right: 0; top: 28%; align-items: center; }
.banner {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--gold-bright);
    text-shadow: 0 0 24px rgba(255, 215, 107, 0.7);
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.damage-vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; -unity-background-scale-mode: stretch-to-fill; }
.dmg-number { position: absolute; translate: -50% -50%; font-size: 19px; -unity-font-style: bold; color: #ffffdd; text-shadow: 0 2px 2px #000000; }
.dmg-number.crit { color: var(--gold-bright); font-size: 27px; text-shadow: 0 0 12px var(--gold-bright); }

/* ---- Death screen ---------------------------------------------------------------- */
.death { background-color: rgba(20, 4, 4, 0.9); }
.death-title { font-size: 60px; color: #ff5a4a; text-shadow: 0 0 30px rgba(255, 40, 40, 0.7); letter-spacing: 6px; }
.death-sub { color: rgba(233, 220, 191, 0.8); -unity-font-style: italic; margin-bottom: 12px; }

/* ---- Dialogue ------------------------------------------------------------------------- */
.dialogue {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 8%;
}
.dialogue-box {
    width: 760px; max-width: 92%;
    background-color: rgba(21, 15, 32, 0.96);
    border-width: 3px; border-color: var(--gold);
    border-radius: 14px;
    padding: 18px 24px;
}
.speaker {
    font-size: 20px; color: var(--gold-bright);
    text-shadow: 0 0 10px rgba(255, 215, 107, 0.4);
    margin-bottom: 8px; padding-bottom: 6px;
    border-bottom-width: 1px; border-color: rgba(202, 168, 77, 0.4);
}
.dlg-text { font-size: 16px; color: var(--parchment); white-space: normal; min-height: 48px; }
.dlg-choices { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; margin-top: 16px; }
.dlg-choice {
    background-color: rgba(50, 36, 72, 0.9);
    border-width: 2px; border-color: rgba(202, 168, 77, 0.6);
    border-radius: 8px;
    padding: 8px 18px;
    margin-left: 10px;
    transition-property: translate, border-color;
    transition-duration: 0.12s;
}
.dlg-choice .btn-text { font-size: 15px; color: var(--parchment); }
.dlg-choice:hover { border-color: var(--gold-bright); translate: 0 -2px; }
.dlg-choice:hover .btn-text { color: var(--gold-bright); }
.dlg-choice.primary { background-color: rgba(50, 27, 81, 0.95); border-color: var(--purple-bright); }
.dlg-choice.primary .btn-text { color: #ffffff; }

/* ---- Book modal ------------------------------------------------------------------- */
.book-modal {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(3, 6, 5, 0.78);
    align-items: center; justify-content: center;
}
.book-frame { align-items: center; }
.book-tabs { flex-direction: row; justify-content: center; height: 36px; align-items: flex-end; }
.book-tab {
    flex-direction: row; align-items: center;
    background-color: #2f2212;
    border-width: 2px; border-bottom-width: 0; border-color: var(--gold);
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    padding: 6px 12px;
    margin: 0 3px;
}
.book-tab .btn-text { font-size: 13px; color: var(--parchment); }
.book-tab:hover .btn-text { color: var(--gold-bright); }
.book-tab.active { background-color: #5a4120; translate: 0 2px; }
.book-tab.active .btn-text { color: var(--gold-bright); }
.book {
    flex-direction: row;
    width: 100%;
    border-width: 10px; border-color: #4a3520;
    border-radius: 10px;
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
}
.book-spine { width: 6px; background-color: #5a4224; }
.book-page { flex-grow: 1; flex-basis: 0; padding: 26px 30px; }
.book-page .unity-scroll-view__content-container { padding-right: 6px; }
.book-close {
    position: absolute; top: 8px; right: 12px;
    width: 32px; height: 32px;
    border-radius: 16px;
    background-color: #4a3520;
    border-width: 2px; border-color: var(--gold);
    align-items: center; justify-content: center;
}
.book-close:hover { background-color: #b04a3a; rotate: 90deg; }

/* Page typography */
.page-title {
    font-size: 25px; color: #5a3a14;
    border-bottom-width: 2px; border-color: rgba(90, 58, 20, 0.4);
    padding-bottom: 6px; margin-bottom: 6px;
    white-space: normal;
}
.page-flourish { -unity-font-style: italic; color: #7a5a30; margin-bottom: 14px; font-size: 14px; }
.sub-title { color: #5a3a14; margin-top: 14px; margin-bottom: 6px; font-size: 17px; }
.empty-note { color: #8a6a40; -unity-font-style: italic; padding: 16px 0; white-space: normal; }
.hint-line { margin-top: 12px; color: #6a4a20; -unity-font-style: italic; font-size: 13px; white-space: normal; }
.locked-line { color: #9a3a2a; }
.spell-desc { color: #3a2a1a; margin: 8px 0; white-space: normal; }

/* Inventory */
.inv-grid { flex-direction: column; margin-top: 8px; }
.inv-item {
    flex-direction: row; align-items: center;
    background-color: rgba(90, 58, 20, 0.12);
    border-width: 1px; border-color: rgba(90, 58, 20, 0.3);
    border-radius: 6px;
    padding: 7px 10px; margin-bottom: 6px;
}
.inv-item.usable:hover { background-color: rgba(90, 58, 20, 0.25); border-color: var(--gold); }
.inv-icon { margin-right: 10px; }
.inv-name { flex-grow: 1; color: #3a2a1a; -unity-font-style: bold; }
.inv-count { color: #7a5a30; -unity-font-style: bold; margin-left: 8px; }
.inv-use { color: #1f5a3a; -unity-font-style: bold; font-size: 13px; margin-left: 8px; }
.char-sheet { flex-direction: column; margin: 8px 0; }
.char-row { flex-direction: row; justify-content: space-between; padding: 5px 8px; border-bottom-width: 1px; border-color: rgba(90, 58, 20, 0.3); }
.char-key { color: #7a5a30; }
.char-val { color: #3a2a1a; -unity-font-style: bold; }
.relic-row { flex-direction: row; align-items: center; padding: 6px 0; border-bottom-width: 1px; border-color: rgba(90, 58, 20, 0.25); }
.relic-text { font-size: 13px; color: #3a2a1a; white-space: normal; flex-shrink: 1; }

/* Shared list entries (spells, beasts, quests, regions) */
.entry-list { flex-direction: column; margin-top: 8px; }
.book-entry {
    flex-direction: row; align-items: center;
    padding: 8px 10px; margin-bottom: 5px;
    border-radius: 6px;
    background-color: rgba(90, 58, 20, 0.08);
    border-width: 1px; border-color: rgba(0, 0, 0, 0);
}
.book-entry:hover { background-color: rgba(90, 58, 20, 0.2); border-color: var(--gold); }
.book-entry.locked { opacity: 0.55; }
.book-entry.unknown { opacity: 0.5; }
.book-entry.completed { opacity: 0.6; }
.book-entry.current { border-color: #1f5a3a; background-color: rgba(40, 120, 70, 0.15); }
.entry-meta { flex-grow: 1; margin-left: 10px; }
.entry-name-row { flex-direction: row; align-items: center; }
.entry-name { color: #3a2a1a; -unity-font-style: bold; margin-left: 4px; }
.entry-sub { font-size: 13px; color: #7a5a30; white-space: normal; }
.spell-school {
    width: 38px; height: 38px;
    border-radius: 8px;
    border-width: 2px;
    background-color: rgba(0, 0, 0, 0.08);
    align-items: center; justify-content: center;
}
.tier { font-size: 11px; background-color: #1f5a3a; color: #ffffff; padding: 1px 7px; border-radius: 8px; margin-left: 6px; }
.lock { font-size: 11px; background-color: #9a3a2a; color: #ffffff; padding: 1px 7px; border-radius: 8px; margin-left: 6px; }
.spell-stats { flex-direction: row; flex-wrap: wrap; margin: 10px 0; }
.stat-chip { background-color: rgba(90, 58, 20, 0.16); border-radius: 6px; padding: 4px 10px; font-size: 13px; color: #3a2a1a; margin: 0 8px 8px 0; }
.upgrade-box { background-color: rgba(60, 40, 100, 0.14); border-left-width: 3px; border-color: #6a3aa8; padding: 8px 12px; border-radius: 4px; margin-top: 8px; }
.upgrade-text { color: #3a2a1a; white-space: normal; }
.beast-dot { width: 16px; height: 16px; border-radius: 8px; margin-right: 6px; }
.quest-tag { font-size: 10px; padding: 2px 8px; border-radius: 8px; -unity-font-style: bold; min-width: 52px; -unity-text-align: middle-center; margin-right: 6px; }
.quest-tag.available { background-color: var(--gold); color: #2a1c08; }
.quest-tag.active { background-color: #7fc8ff; color: #06243a; }
.quest-tag.ready { background-color: var(--green-bright); color: #04140c; }
.quest-tag.completed { background-color: #7a5a30; color: #ffffff; }
.quest-summary { color: #3a2a1a; -unity-font-style: bold; margin: 6px 0; white-space: normal; }
.obj-row { flex-direction: row; align-items: center; padding: 3px 0; }
.obj-text { color: #3a2a1a; white-space: normal; flex-shrink: 1; }
.obj-row.done .obj-text { color: #1f5a3a; opacity: 0.7; }
.region-orb { width: 22px; height: 22px; border-radius: 11px; }
.here { font-size: 10px; background-color: #1f5a3a; color: #ffffff; padding: 1px 7px; border-radius: 8px; margin-left: 6px; }

/* Settings + controls */
.settings-list { flex-direction: column; margin: 12px 0; }
.set-row { flex-direction: column; margin-bottom: 12px; }
.set-label { color: #3a2a1a; -unity-font-style: bold; }
.set-slider { margin: 4px 0 0 0; }
.set-toggle { margin-bottom: 10px; }
.set-toggle Label { color: #3a2a1a; -unity-font-style: bold; }
.settings-buttons { flex-direction: row; flex-wrap: wrap; margin-top: 16px; }
.settings-buttons > * { margin-right: 10px; margin-bottom: 6px; }
.menu-btn.danger { border-color: #b04a3a; }
.menu-btn.danger .btn-text { color: #ff9a8a; }
.control-row { flex-direction: row; padding: 5px 8px; border-bottom-width: 1px; border-color: rgba(90, 58, 20, 0.3); }
.control-key { width: 120px; color: #5a3a14; }
.control-val { color: #3a2a1a; flex-shrink: 1; white-space: normal; }
.god-row { padding: 5px 0; color: #3a2a1a; font-size: 13px; border-bottom-width: 1px; border-color: rgba(90, 58, 20, 0.25); white-space: normal; }
.pause-buttons { min-width: 0; }
.pause-buttons > * { margin-bottom: 10px; }
.pause-buttons .menu-btn { padding: 9px 18px; }
.pause-buttons .menu-btn .btn-text { font-size: 15px; }

/* ---- Intro title card -------------------------------------------------------------- */
.intro { background-color: #000000; }
.intro-scene { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.title-card {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column; align-items: center; justify-content: flex-start;
    padding-top: 14%;
}
.prophecy { margin-top: 24px; align-items: center; }
.prophecy-line { color: rgba(233, 220, 191, 0.85); -unity-font-style: italic; font-size: 17px; margin: 2px 0; }
.title-hint { margin-top: 24px; color: rgba(233, 220, 191, 0.5); font-size: 13px; letter-spacing: 3px; }
